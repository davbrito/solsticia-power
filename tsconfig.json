{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "plugins": [{ "name": "@astrojs/ts-plugin" }],
    "strictNullChecks": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@lib/*": ["./src/lib/*"],
      "@utils/*": ["./src/utils/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@assets/*": ["./src/assets/*"],
      "@pages/*": ["./src/pages/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
